# Tables are isolated into this PostgreSQL schema (the database may be shared).
DATABASE_SCHEMA="jawbts-api"

# Neon PostgreSQL connection string. Three transports, picked in src/lib/prisma.ts:
#
# 1. Production (Neon WebSocket pool) — the default:
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-PROJECT.neon.tech/YOUR-DB?sslmode=require"
#
# 2. Neon HTTP transport — use when the URL itself is http(s):// :
# DATABASE_URL="https://USER:PASSWORD@YOUR-PROJECT.neon.tech/YOUR-DB"
#
# 3. Local development — `npx prisma dev` + the Neon HTTP bridge. Point
#    DATABASE_URL at the local server the `prisma dev` command prints, and set
#    NEON_HTTP_ENDPOINT to the bridge (see scripts/neon-http-bridge.mjs).
#    Keep NEON_HTTP_ENDPOINT in .env.development only — never production:
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1"
# NEON_HTTP_ENDPOINT="http://127.0.0.1:51220/sql"
#
# Optional shadow database for `prisma migrate dev`:
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1"

# GitHub OAuth login (see src/lib/github.ts). There is no registration: users
# must already exist in the users table (name = GitHub username, githubId set).
GITHUB_CLIENT_ID="your-github-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-app-client-secret"
# The UI page that receives GitHub's redirect and forwards code+state to
# POST /api/auth/github/callback.
GITHUB_REDIRECT_URI="https://your-ui.example.com/auth/github/callback"

# Resend — activity alert emails. Every login/refresh from an IP+user-agent
# fingerprint unseen in the last 7 days emails the account owner. If the
# account has an email and the send fails, the login/refresh fails (10012).
# The API key must grant sending for the RESEND_FROM address/domain.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="Api Bot <api-bot@noreply.jawbts.org>"

# Required. Deployment-wide pepper mixed into the SHA-512 activity
# fingerprints. A leaked activity_hashes table is useless without it. Changing
# it invalidates every stored fingerprint (all devices re-alert once).
# Generate both secrets with:
# node -e 'const c=require("node:crypto"); for (const k of ["ACTIVITY_HASH_SALT","JWKS_ENCRYPTION_KEY"]) console.log(`${k}="${c.randomBytes(48).toString("base64url")}"`);'
ACTIVITY_HASH_SALT="a-long-random-activity-salt"

# Required. Key material used to encrypt JWKS private keys at rest with
# AES-256-GCM. Treat it like a root secret: losing it makes existing private
# keys unusable (a fresh key is generated on rotation).
JWKS_ENCRYPTION_KEY="a-long-random-jwks-encryption-key"

# Required in production. Canonical origin used by /auth/verify to fetch
# /.well-known/jwks.json. Without it, production refuses to derive the origin
# from the request Host header. Local/dev may omit it.
JWKS_ORIGIN="https://api.example.com"


# Optional overrides for `npm run db:seed` (the manual testing account).
# Defaults: winsrewu / winsrewu@jawbts.org / 78122384, with the permissions
# issue_tokens and play_sequence_override.
# SEED_NAME="winsrewu"
# SEED_EMAIL="winsrewu@jawbts.org"
# SEED_GITHUB_ID="78122384"
# SEED_PERMISSIONS="issue_tokens,play_sequence_override"
