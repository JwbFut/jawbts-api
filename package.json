{
  "name": "jawbts-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:start": "node scripts/prisma-dev.mjs dev --name jawbts --port 51213 --db-port 51214 --shadow-db-port 51215",
    "db:start:bg": "node scripts/prisma-dev.mjs dev --detach --name jawbts --port 51213 --db-port 51214 --shadow-db-port 51215",
    "db:stop": "node scripts/prisma-dev.mjs dev stop jawbts",
    "db:ls": "node scripts/prisma-dev.mjs dev ls",
    "db:status": "node scripts/db-status.mjs",
    "db:reset-email": "node scripts/reset-email-change.mjs",
    "db:push": "prisma db push && node scripts/ensure-email-index.mjs",
    "db:seed": "prisma db push --accept-data-loss && node scripts/ensure-email-index.mjs && node scripts/seed-test-user.mjs",
    "db:index": "node scripts/ensure-email-index.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && node scripts/ensure-email-index.mjs",
    "dev:bridge": "node scripts/neon-http-bridge.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "jose": "^6.2.7",
    "next": "^16.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
